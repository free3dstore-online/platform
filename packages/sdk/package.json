{
  "name": "@free3dstore/sdk",
  "version": "0.1.0",
  "description": "Browser SDK for 3D tools on free3dstore.online — Three.js scene engine, model loading (GLB/OBJ/STL/FBX), format conversion, PBR materials, mesh optimization.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "three": { "optional": true }
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@types/react": "^19.0.0",
    "three": "^0.170.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "sideEffects": false
}
